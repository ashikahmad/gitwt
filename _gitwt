#compdef gitwt
# gitwt zsh completion
# Source this file in your .zshrc (after sourcing gitwt.sh):
#   source ~/.config/gitwt/_gitwt

_gitwt() {
  local state

  _arguments \
    '1: :->cmd' \
    '*: :->args' \
    && return 0

  case "$state" in
    cmd)
      local -a commands
      commands=(
        'new:Create worktree for a new or existing branch, and cd in'
        'switch:cd into an existing worktree'
        'sw:cd into an existing worktree (alias for switch)'
        'remove:Remove a worktree'
        'move:Move a worktree to another folder'
        'mv:Move a worktree to another folder (alias for move)'
        'list:Show all worktrees with sync and changes state'
        'ls:Show all worktrees with sync and changes state (alias for list)'
        'version:Show gitwt version'
        'help:Show help'
      )
      _describe 'command' commands
      ;;

    args)
      case "${words[2]}" in
        new)       _gitwt_complete_new ;;
        switch|sw) _gitwt_complete_worktree_branches ;;
        remove)    _gitwt_complete_remove ;;
        list|ls)
          (( CURRENT == 3 )) && compadd -- -l --long -s --short ;;
        move|mv)
          if (( CURRENT == 3 )); then _gitwt_complete_movable_branches
          elif (( CURRENT == 4 )); then _files -/
          fi ;;
      esac
      ;;
  esac
}

# `new` — local branches without a worktree, plus --from / --fetch flags. Remote branches can
# number in the hundreds, so they don't crowd that list: each remote is offered as "origin/",
# and its branches are completed once the word starts with it, one path part at a time.
_gitwt_complete_new() {
  local -a flags checked_out local_branches available

  # After --from: local branches, then a remote's branches once the word starts with it
  if [[ "${words[-2]}" == "--from" ]]; then
    local_branches=("${(@f)$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)}")
    _gitwt_complete_branches_or_remote 0 "${local_branches[@]}"
    return
  fi

  # Existing branches that don't already have a worktree
  checked_out=("${(@f)$(git worktree list --porcelain 2>/dev/null \
    | awk '/^branch / { sub(/^refs\/heads\//, "", $2); print $2 }')}")
  local_branches=("${(@f)$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)}")
  available=("${(@)local_branches:|checked_out}")
  available=("${(@)available:#}")

  _gitwt_complete_branches_or_remote 1 "${available[@]}" && return

  # Flags not already used
  local used="${words[*]}"
  [[ "$used" != *"--from"* ]] && flags+=(--from)
  [[ "$used" != *"--fetch"* ]] && flags+=(--fetch)
  [[ ${#flags[@]} -gt 0 ]] && compadd -a flags
}

# Completes the given local branches plus one "<remote>/" entry per remote. Once the word
# starts with <remote>/, completes that remote's branches instead and returns 0. With
# <only_new> set to 1 (for the branch name, not --from), remote branches that already exist
# locally are left out, and when nothing local matches what's typed, branches only a remote
# has are offered by their local name.
_gitwt_complete_branches_or_remote() {
  local only_new="$1"; shift
  local -a remotes prefixes refs local_branches
  local r remote=""

  remotes=("${(@f)$(git remote 2>/dev/null)}")
  remotes=("${(@)remotes:#}")
  for r in "${remotes[@]}"; do
    [[ "$PREFIX" == "$r/"* && ${#r} -gt ${#remote} ]] && remote="$r"
  done

  if [[ -n "$remote" ]]; then
    _gitwt_remote_branch_names "$remote" "${remotes[@]}"
    refs=("${reply[@]}")
    if (( only_new )); then
      local_branches=("${(@f)$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)}")
      refs=("${(@)refs:|local_branches}")
    fi
    refs=("${(@)refs/#/$remote/}")
    # One path part at a time: origin/<Tab> lists feature/, fix/, main, …
    (( ${#refs} )) && _multi_parts / refs
    return 0
  fi

  (( $# )) && compadd -- "$@"

  # Typed something no local branch starts with: offer the branches only a remote has, by
  # their local name, which gitwt new tracks. Only matching ones show, so the list stays short.
  # Only names gitwt new can settle: on one remote, or on checkout.defaultRemote.
  if (( only_new )) && [[ -n "$PREFIX" ]] && (( compstate[nmatches] == 0 )); then
    local default n
    local -A count on_default
    default="$(git config --get checkout.defaultRemote 2>/dev/null)"
    for r in "${remotes[@]}"; do
      _gitwt_remote_branch_names "$r" "${remotes[@]}"
      for n in "${reply[@]}"; do
        count[$n]=$(( ${count[$n]:-0} + 1 ))
        [[ "$r" == "$default" ]] && on_default[$n]=1
      done
    done
    local_branches=("${(@f)$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)}")
    refs=()
    for n in "${(@k)count}"; do
      [[ "${count[$n]}" == 1 || -n "${on_default[$n]}" ]] || continue
      (( ${local_branches[(Ie)$n]} )) || refs+=("$n")
    done
    (( ${#refs} )) && _multi_parts / refs
  fi

  prefixes=("${(@)remotes/%//}")
  (( ${#prefixes} )) && compadd -S '' -- "${prefixes[@]}"
  return 1
}

# Sets reply to <remote>'s branch names, without the remote (feature/x for origin/feature/x),
# leaving out HEAD and the branches of any other remote listed after it whose name starts with
# <remote>/ (with remotes "up" and "up/stream", up/stream/x is up/stream's, not up's).
_gitwt_remote_branch_names() {
  local remote="$1" r
  shift
  local -a refs
  refs=("${(@f)$(git for-each-ref --format='%(refname)' "refs/remotes/$remote" 2>/dev/null)}")
  for r in "$@"; do
    [[ "$r" == "$remote/"* ]] && refs=("${(@)refs:#refs/remotes/$r/*}")
  done
  refs=("${(@)refs#refs/remotes/$remote/}")
  reply=("${(@)${(@)refs:#HEAD}:#}")
}

# `move` — branches with a worktree, except the main repo's, which can't be moved
_gitwt_complete_movable_branches() {
  local -a branches
  branches=("${(@f)$(git worktree list --porcelain 2>/dev/null \
    | awk '/^worktree / { n++ } n > 1 && /^branch / { sub(/^refs\/heads\//, "", $2); print $2 }')}")
  compadd -a branches
}

# `switch` — complete from branches that have a live worktree
_gitwt_complete_worktree_branches() {
  local -a branches

  branches=("${(@f)$(git worktree list --porcelain 2>/dev/null \
    | awk '/^branch / { sub(/^refs\/heads\//, "", $2); print $2 }')}")

  compadd -a branches
}

# `remove` — worktree branches + --branch flag
_gitwt_complete_remove() {
  local -a branches

  branches=("${(@f)$(git worktree list --porcelain 2>/dev/null \
    | awk '/^branch / { sub(/^refs\/heads\//, "", $2); print $2 }')}")

  compadd -a branches

  local used="${words[*]}"
  [[ "$used" != *"--branch"* ]] && compadd -- --branch
}

# compdef only exists once compinit has run. If it hasn't yet (this file sourced before
# compinit, or compinit deferred by a plugin manager), register at the next prompt that
# has it, instead of printing "command not found: compdef" at every shell start.
if (( $+functions[compdef] )); then
  compdef _gitwt gitwt
else
  _gitwt_register() {
    (( $+functions[compdef] )) || return 0
    compdef _gitwt gitwt
    add-zsh-hook -d precmd _gitwt_register
    unfunction _gitwt_register
  }
  autoload -Uz add-zsh-hook && add-zsh-hook precmd _gitwt_register
fi
